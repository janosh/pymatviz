    "@wooorm/starry-night": "^3.11.0",
    "pagefind": "^1.5.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-widgets": "github:janosh/svelte-widgets#main",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@11.23.0"
